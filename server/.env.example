# Copy this file to ".env" and adjust if needed. Every value is optional.

# Where Ollama is running (default is its standard local address)
OLLAMA_HOST=http://127.0.0.1:11434

# The model to use. Pull it first:  ollama pull llama3.1:8b
# Alternatives: qwen2.5:7b (follows JSON very well), llama3.2:3b (faster, lighter laptops)
OLLAMA_MODEL=llama3.1:8b

# Local models can be slow on CPU. Give them time (milliseconds).
OLLAMA_TIMEOUT_MS=300000

# Context window and how long Ollama keeps the model in memory after a request
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m

# API server port and a simple per-IP request limit (requests per minute)
PORT=8787
RATE_LIMIT_PER_MIN=12

# Accounts. AUTH_SECRET signs the session cookie. If you leave it empty, a random one is created once
# and stored in server/data/.secret. Set your own in production.
# AUTH_SECRET=change-me-to-a-long-random-string
# Public address of the website (used in password-reset links)
# PUBLIC_URL=http://localhost:5173
# Where users and saved reports are stored. Leave DATABASE_URL empty to use a JSON file in DATA_DIR (fine at home).
# On a hosted site set DATABASE_URL to your Supabase "Session pooler" connection string so accounts survive redeploys.
# DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DATA_DIR=./data
# Set to 1 when the site is served over HTTPS
# COOKIE_SECURE=1
